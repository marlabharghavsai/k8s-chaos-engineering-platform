        "legend": { "calcs": ["mean", "max"], "displayMode": "table", "placement": "bottom" },
        "tooltip": { "mode": "single", "sort": "none" }
      },
      "pluginVersion": "11.1.0",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "Prometheus" },
          "editorMode": "code",
          "expr": "(sum(rate(container_network_receive_errors_total{namespace=\"online-boutique\"}[1m])) / (sum(rate(container_network_receive_packets_total{namespace=\"online-boutique\"}[1m])) + 0.001)) * 100 or vector(0)",
          "legendFormat": "Network & HTTP Error %",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "HTTP & Network Error Rate (% Injected / Faults)",
      "type": "timeseries"
    },
